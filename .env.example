# Copy to .env for local (non-container) development.
# Inside docker-compose, these are set directly in docker-compose.yml instead.
# npm scripts don't auto-load this file (no dotenv wired in) -- export these
# in your shell, or run via docker/podman compose where they're set for you.

# Used by `npm run dev` / `npm start`. Connect as the app role, not the
# superuser -- see P9 in docs/assumptions.md. The app_user role and its
# password are created by migrations/001_initial_schema.ts.
DATABASE_URL=postgres://app_user:app_user_dev_password@localhost:5432/billingtest

# Used only by `npm run migrate`. A *different* role from DATABASE_URL above,
# deliberately -- migrations run as the bootstrap superuser because they
# CREATE ROLE and CREATE POLICY, both of which app_user must never be able
# to do. See ADR 0006. Never used by the running API.
MIGRATE_DATABASE_URL=postgres://postgres:postgres_dev_only@localhost:5432/billingtest

# The password migrations/001_initial_schema.ts assigns when it creates
# app_user. Must match the credential embedded in DATABASE_URL above.
APP_USER_PASSWORD=app_user_dev_password

PORT=3000
HOST=0.0.0.0
